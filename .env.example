# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATA_GOV_IN_API_KEY: Optional API key from data.gov.in (Government Open Data Platform India)
# If provided, the app will query live endpoints directly. Otherwise, it uses the official Agmarknet verified open dataset.
DATA_GOV_IN_API_KEY=""

# BHASHINI_USER_ID & BHASHINI_API_KEY: Optional credentials for BHASHINI National Language Translation Mission
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""

# SMS_PROVIDER_API_KEY: Optional SMS gateway key for sending live SMS OTPs (e.g. Fast2SMS / Twilio)
# When not set, the app runs in clearly labeled "DEVELOPMENT OTP MODE" with zero fake data.
SMS_PROVIDER_API_KEY=""

